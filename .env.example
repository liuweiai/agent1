APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_BACKEND=sqlite
DATABASE_PATH=./data/factorypilot.db
DATABASE_URL=mysql://factorypilot:factorypilot@localhost:3306/factorypilot
CHECKPOINT_PATH=./data/checkpoints.db
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_FAIL_OPEN=true
REDIS_LOCK_TTL_SECONDS=1800
TASK_QUEUE_BACKEND=local
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_QUEUE=factorypilot
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AGENT_MODE=demo
KNOWLEDGE_BACKEND=lexical
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=factorypilot_knowledge
MILVUS_FAIL_OPEN=true
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=factorypilot-graph
NEO4J_DATABASE=neo4j
NEO4J_FAIL_OPEN=true
TOOL_TRANSPORT=inprocess
MES_MCP_URL=http://localhost:8101/mcp
KNOWLEDGE_MCP_URL=http://localhost:8102/mcp
ACTION_MCP_URL=http://localhost:8103/mcp
A2A_ENABLED=false
VENDOR_A2A_CARD_URL=http://localhost:8200/.well-known/agent-card.json
VENDOR_A2A_PUBLIC_URL=http://localhost:8200/a2a
VENDOR_A2A_TOKEN=factorypilot-vendor-token
A2A_TIMEOUT_SECONDS=8
A2A_FAIL_OPEN=true
MCP_TRUST_ENV=false
REQUIRE_GATEWAY_AUTH=false
GATEWAY_SHARED_SECRET=change-this-in-production
JWT_SECRET=factorypilot-demo-jwt-secret-change-me-2026
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多工作区个人令牌或组织级服务密钥需要填写
# LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT=factorypilot
LANGSMITH_DATASET=factorypilot-regression-v1
# LANGSMITH_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=gpt-4.1-mini
LLM_FAIL_OPEN=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Docker 无法直连模型服务时，按本机代理端口填写：
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,mysql,redis,neo4j,milvus,mes-mcp,knowledge-mcp,action-mcp,vendor-agent,mes-gateway
